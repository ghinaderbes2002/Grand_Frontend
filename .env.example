# Backend base URL. Server-side only: the browser never calls the API directly,
# every request goes through this app so tokens stay in httpOnly cookies.
# Direct: http://localhost:3000 — behind the Nginx reverse proxy: http://localhost
API_BASE_URL=http://localhost:3000

# Public origin of this frontend. Used as the base for canonical and Open Graph
# URLs on product pages — set it to the real domain in production.
SITE_URL=http://localhost:3001

# Origin of the object store the API issues presigned URLs for (MinIO locally,
# S3-compatible in production). Allows next/image to resize and convert product
# images. Leave it unset and images still render, just unoptimized.
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9000

# Session cookies carry `Secure` in production, which a browser only accepts
# over HTTPS — served over plain HTTP it discards them and every visit to
# /account, /cart or /admin bounces back to the login page. Set this to `false`
# on a host that has no TLS yet. It is read at BUILD time (the proxy inlines
# its environment), so a rebuild is required, and the tokens then travel in
# clear text — put the site behind HTTPS and remove this.
# COOKIE_SECURE=false

# Social links shown in the storefront footer. Each icon renders only when its
# URL is set, so an unused account leaves no dead link behind.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
