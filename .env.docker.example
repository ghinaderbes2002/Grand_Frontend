# Copy to `.env` next to docker-compose.yml on the server, then:
#   docker compose up -d --build
#
# Compose reads `.env` automatically for the substitutions below.

# --- required ---------------------------------------------------------------

# Where this container reaches the backend. Pick the line that matches how the
# backend runs — see "Deploying" in the README.
#
#   backend on the host (not in Docker):
#     API_BASE_URL=http://host.docker.internal:3019
#   backend in a container on the same compose network:
#     API_BASE_URL=http://api:3000
#   backend anywhere else:
#     API_BASE_URL=http://217.76.53.136:3019
#
# A path prefix is supported, for a backend behind NestJS's `setGlobalPrefix`:
#     API_BASE_URL=http://host.docker.internal:3019/api
#
# Confirm the port answers before deploying:
#   curl http://<host>:<port>/health/live   ->   {"status":"ok"}
API_BASE_URL=http://host.docker.internal:3019

# Public origin of this frontend, used for canonical and Open Graph URLs.
# Must match how visitors actually reach it, including the port.
SITE_URL=http://217.76.53.136:3018

# --- optional ---------------------------------------------------------------

# Host port to publish on. The container always listens on 3000 internally.
# 3016 and 3017 belong to an unrelated project on this server — leave them be.
WEB_PORT=3018

# Origin of the object store (MinIO/S3) the API issues presigned URLs for.
# Baked in at build time, so changing it needs `--build`. Leave empty and
# images still render, just without resizing or format conversion.
NEXT_PUBLIC_MEDIA_ORIGIN=http://217.76.53.136:9000

# Set to 0 to turn off catalog caching.
CACHE_TTL_SCALE=1
